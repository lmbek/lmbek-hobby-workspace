# AI ignore rules
# By default, AI tools may inherit .gitignore patterns.
# We override that behavior here to ensure important files remain visible.

# Ignore build artifacts and IDE config (same as .gitignore)
.idea/
bin/
*.exe
*.test
*.out
*.html
vendor/
.DS_Store

# Do NOT ignore git-repositories/ — AI needs access to those files
# (intentionally omitted from this file, unlike .gitignore)

# Ensure all README.md files are always included
!**/README.md
!README.md
