# ─── Workspace Configuration ──────────────────────────────────────────────────
# Copy this file to .env and adjust values for your local environment.
# The git-controller reads these at runtime.

# Root directory of the workspace (auto-detected by Makefile, override if needed)
# WORKSPACE_ROOT=/path/to/LMBEK-HOBBY-WORKSPACE

# ─── Category Directory Overrides ────────────────────────────────────────────
# By default, repos are cloned to git-repositories/<category>/.
# Set these to override the default location for any category.
# APPLICATIONS_DIR=/custom/path/to/applications
# INFRASTRUCTURE_DIR=/custom/path/to/infrastructure
# ORCHESTRATOR_DIR=/custom/path/to/orchestrator
# DEPLOYMENT_DIR=/custom/path/to/deployment
# OBSERVABILITY_DIR=/custom/path/to/observability
# PLATFORM_DIR=/custom/path/to/platform
# TOOLS_DIR=/custom/path/to/tools
# DOCS_DIR=/custom/path/to/docs

# ─── Debug ────────────────────────────────────────────────────────────────────
# Set to "true" for verbose debug logging from the git-controller.
# DEBUG=false

# ─── Go Toolchain ────────────────────────────────────────────────────────────
# If you have multiple Go versions, pin the toolchain.
# GOTOOLCHAIN=local
