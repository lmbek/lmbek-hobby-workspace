# ─── Optional Environment Variables ───────────────────────────────────────────
# No .env file is required. The git-controller auto-detects everything it needs.
# The variables below are optional overrides you can export in your shell.

# ─── Debug ────────────────────────────────────────────────────────────────────
# Set to "true" for verbose debug logging from the git-controller.
# DEBUG=false

# ─── Go Toolchain ────────────────────────────────────────────────────────────
# If you have multiple Go versions, pin the toolchain.
# GOTOOLCHAIN=local
