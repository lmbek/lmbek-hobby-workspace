# Workspace Controller Makefile
# Thin wrapper around git-controller commands.

# Go installation settings (override on the command line, e.g. `make install-go GO_VERSION=1.26.4`)
GO_VERSION ?= 1.26.4
GO_INSTALL_DIR ?= $(HOME)/.local

.PHONY: help init clone fetch pull push scaffold checkout status validate doctor ssh ssh-setup update test cover install-go

help:
	@echo "Workspace Controller - Available commands:"
	@echo ""
	@echo "  Workflow:"
	@echo "  make init      - Scaffold a new workspace"
	@echo "  make clone     - Clone all repositories (initial setup)"
	@echo "  make fetch     - Fetch all remotes across all repositories"
	@echo "  make pull      - Pull updates across all repositories (clone if missing)"
	@echo "  make update    - Fetch, pull, and show status across all repositories"
	@echo "  make push      - Push local commits across all repositories"
	@echo "  make scaffold  - Initialise .git, set remote origin, fetch, and configure default branch"
	@echo "  make checkout  - Switch all repos to their defined branch"
	@echo "  make status    - Show dashboard overview of all repository states"
	@echo "  make validate  - Validate repository consistency"
	@echo ""
	@echo "  Testing:"
	@echo "  make test      - Run all tests"
	@echo "  make cover     - Run tests with HTML coverage report"
	@echo ""
	@echo "  Setup:"
	@echo "  make doctor    - Diagnose environment (Git, Go, SSH, Docker)"
	@echo "  make ssh       - Interactive SSH setup (alias: ssh-setup)"
	@echo ""
	@echo "  Installation:"
	@echo "  make install-go      - Download, verify, and install Go $(GO_VERSION) to $(GO_INSTALL_DIR)/go"

init:
	cd git-controller && go run . init

clone:
	cd git-controller && go run . clone

fetch:
	cd git-controller && go run . fetch

pull:
	cd git-controller && go run . pull

push:
	cd git-controller && go run . push

scaffold:
	cd git-controller && go run . scaffold

checkout:
	cd git-controller && go run . checkout

status:
	cd git-controller && go run . status

validate:
	cd git-controller && go run . validate

doctor:
	cd git-controller && go run . doctor

ssh:
	cd git-controller && go run . ssh

update:
	cd git-controller && go run . update

test:
	cd git-controller && go test ./...

cover:
	cd git-controller && go test -coverprofile=cover.out ./... && go tool cover -html=cover.out -o cover.html
	@echo "Coverage report: git-controller/cover.html"

ssh-setup: ssh

install-go:
	@bash -euc '\
		version="$(GO_VERSION)"; \
		dest="$(GO_INSTALL_DIR)"; \
		os="$$(uname -s)"; \
		case "$$os" in \
			Linux) os_name="linux" ;; \
			Darwin) os_name="darwin" ;; \
			MINGW*|MSYS*|CYGWIN*) os_name="windows" ;; \
			*) echo "Unsupported operating system: $$os" >&2; exit 1 ;; \
		esac; \
		case "$$(uname -m)" in \
			x86_64|amd64) arch="amd64" ;; \
			aarch64|arm64) arch="arm64" ;; \
			*) echo "Unsupported architecture: $$(uname -m)" >&2; exit 1 ;; \
		esac; \
		if [ "$$os_name" = "windows" ]; then \
			tarball="go$${version}.$${os_name}-$${arch}.zip"; \
		else \
			tarball="go$${version}.$${os_name}-$${arch}.tar.gz"; \
		fi; \
		url="https://go.dev/dl/$${tarball}"; \
		tmp="$$(mktemp -d)"; \
		trap "rm -rf $$tmp" EXIT; \
		echo "Downloading $$url"; \
		curl -fSL -o "$$tmp/$$tarball" "$$url"; \
		echo "Verifying checksum..."; \
		expected="$$(curl -fsSL "https://go.dev/dl/?mode=json&include=all" \
			| grep -A4 "\"filename\": \"$${tarball}\"" \
			| grep "\"sha256\"" | head -1 \
			| sed -E "s/.*\"sha256\": \"([a-f0-9]+)\".*/\1/")"; \
		[ -n "$$expected" ] || { echo "Could not fetch published checksum for $$tarball" >&2; exit 1; }; \
		if [ "$$os_name" = "windows" ]; then \
			actual="$$(sha256sum "$$tmp/$$tarball" | cut -d" " -f1)"; \
		else \
			actual="$$(sha256sum "$$tmp/$$tarball" | cut -d" " -f1)"; \
		fi; \
		[ "$$expected" = "$$actual" ] || { echo "Checksum mismatch!" >&2; echo "  expected: $$expected" >&2; echo "  actual:   $$actual" >&2; exit 1; }; \
		echo "Checksum OK ($$actual)"; \
		mkdir -p "$$dest"; \
		rm -rf "$$dest/go"; \
		if [ "$$os_name" = "windows" ]; then \
			unzip -q "$$tmp/$$tarball" -d "$$dest"; \
		else \
			tar -C "$$dest" -xzf "$$tmp/$$tarball"; \
		fi; \
		"$$dest/go/bin/go" version; \
		echo ""; \
		echo "Installed to $$dest/go"; \
		if [ "$$os_name" = "windows" ]; then \
			echo "Add to your PATH (e.g. in environment variables):"; \
			echo "  $$dest\\go\\bin;%USERPROFILE%\\go\\bin"; \
		else \
			echo "Add to your PATH (e.g. in ~/.zshrc or ~/.bashrc):"; \
			echo "  export PATH=\"$$dest/go/bin:\$$HOME/go/bin:\$$PATH\""; \
		fi; \
	'