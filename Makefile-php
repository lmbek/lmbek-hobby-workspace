# Workspace Controller Makefile (PHP)
# Thin wrapper around git-controller-php commands.
# Usage: make -f Makefile-php <command>

.PHONY: help init clone fetch pull push scaffold checkout status validate doctor ssh ssh-setup update install-php

help:
	@echo "Workspace Controller (PHP) - Available commands:"
	@echo ""
	@echo "  Workflow:"
	@echo "  make -f Makefile-php init      - Scaffold a new workspace"
	@echo "  make -f Makefile-php clone     - Clone all repositories (initial setup)"
	@echo "  make -f Makefile-php fetch     - Fetch all remotes across all repositories"
	@echo "  make -f Makefile-php pull      - Pull updates across all repositories (clone if missing)"
	@echo "  make -f Makefile-php update    - Fetch, pull, and show status across all repositories"
	@echo "  make -f Makefile-php push      - Push local commits across all repositories"
	@echo "  make -f Makefile-php scaffold  - Initialise .git, set remote origin, fetch, and configure default branch"
	@echo "  make -f Makefile-php checkout  - Switch all repos to their defined branch"
	@echo "  make -f Makefile-php status    - Show dashboard overview of all repository states"
	@echo "  make -f Makefile-php validate  - Validate repository consistency"
	@echo ""
	@echo "  Setup:"
	@echo "  make -f Makefile-php doctor    - Diagnose environment (Git, PHP, SSH, Docker)"
	@echo "  make -f Makefile-php ssh       - Interactive SSH setup (alias: ssh-setup)"
	@echo ""
	@echo "  Installation:"
	@echo "  make -f Makefile-php install-php     - Install PHP"

init:
	php git-controller-php/main.php init

clone:
	php git-controller-php/main.php clone

fetch:
	php git-controller-php/main.php fetch

pull:
	php git-controller-php/main.php pull

push:
	php git-controller-php/main.php push

scaffold:
	php git-controller-php/main.php scaffold

checkout:
	php git-controller-php/main.php checkout

status:
	php git-controller-php/main.php status

validate:
	php git-controller-php/main.php validate

doctor:
	php git-controller-php/main.php doctor

ssh:
	php git-controller-php/main.php ssh

update:
	php git-controller-php/main.php update

ssh-setup: ssh

install-php:
	@echo "Detecting operating system..."
	@if [ "$$(uname)" = "Darwin" ]; then \
		echo "macOS detected - using Homebrew"; \
		brew install php; \
	elif [ -f /etc/debian_version ]; then \
		echo "Debian/Ubuntu detected - using apt"; \
		sudo apt update && sudo apt install -y php-cli; \
	elif [ -f /etc/redhat-release ] || [ -f /etc/fedora-release ]; then \
		echo "RHEL/Fedora detected - using dnf"; \
		sudo dnf install -y php-cli; \
	elif [ -f /etc/arch-release ]; then \
		echo "Arch Linux detected - using pacman"; \
		sudo pacman -S --noconfirm php; \
	elif [ -f /etc/alpine-release ]; then \
		echo "Alpine Linux detected - using apk"; \
		sudo apk add --no-cache php-cli; \
	elif command -v pacman >/dev/null 2>&1; then \
		echo "Using pacman"; \
		sudo pacman -S --noconfirm php; \
	elif command -v zypper >/dev/null 2>&1; then \
		echo "openSUSE detected - using zypper"; \
		sudo zypper install -y php-cli; \
	elif command -v apt-get >/dev/null 2>&1; then \
		echo "Using apt-get"; \
		sudo apt-get update && sudo apt-get install -y php-cli; \
	elif command -v yum >/dev/null 2>&1; then \
		echo "Using yum"; \
		sudo yum install -y php-cli; \
	elif command -v brew >/dev/null 2>&1; then \
		echo "Using Homebrew"; \
		brew install php; \
	else \
		echo "Unsupported operating system. Please install PHP manually." >&2; \
		exit 1; \
	fi
	@php --version